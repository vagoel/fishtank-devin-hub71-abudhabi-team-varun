# Copy to .env and fill in. .env is gitignored; never commit real keys.
# scripts/run.sh and the server read these at startup (an exported env var wins).

# Devin API service key (cog_...). The org id is looked up via /v3/self.
DEVIN=cog_xxxxxxxxxxxxxxxx
# OpenAI key for the wrist voice assistant (Realtime API)
OPENAI=sk-xxxxxxxxxxxxxxxx

# WhatsApp escalation (optional; unset = dry run, messages go to the log only)
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_TO=+9715XXXXXXXX,+9715YYYYYYYY
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# META_WA_TOKEN=EAAxxxxxxxxxxxxxxxx
# META_WA_PHONE_ID=123456789012345
# META_WA_TEMPLATE=heatguard_incident
# CALLMEBOT_APIKEY=1234567
# HEATGUARD_PUBLIC_URL=http://192.168.1.10:8000
