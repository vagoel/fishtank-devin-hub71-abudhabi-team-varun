# HeatGuard settings. Copy to backend/.env (or point HEATGUARD_ENV_FILE at a file) and fill in.
# .env is gitignored; never commit real keys. Real environment variables always win
# (on Cloud Run everything is set as env vars; see backend/deploy/CLOUD_RUN.md).

# Devin API service key (cog_...). The org id is looked up via /v3/self.
DEVIN=cog_xxxxxxxxxxxxxxxx
# OpenAI key for the wrist voice assistant (GPT-Live) and GPT-Live phone calls
OPENAI=sk-xxxxxxxxxxxxxxxx

# Escalation (optional; missing = dry run). Recipients are comma-separated E.164 numbers.
# WHATSAPP_TO=+9715XXXXXXXX
# CALL_TO=+9715XXXXXXXX
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
# HEATGUARD_PUBLIC_URL=https://<public host>   # Twilio webhooks + dashboard link in messages

# Switches
# HEATGUARD_DEVICE_TOKEN=             # set to require ?token= on /v1/device/ws
# HEATGUARD_AUTO_WHATSAPP=1           # 0 = no automatic WhatsApp / phone escalation
# HEATGUARD_CALLS=1                   # 0 = never place phone calls
# HEATGUARD_LAN=0                     # 1 = UDP gateway, beacon, USB serial, TCP voice (Mac/LAN only)
