<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  HeatGuard gateway server as a per-user LaunchAgent (macOS).
  Install with scripts/install_service.sh install. No secrets here:
  run.sh loads keys at runtime from the project .env and the secrets file.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.heatguard.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/vp/project1/scripts/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vp/project1</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/vp/Library/Logs/heatguard/server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vp/Library/Logs/heatguard/server.log</string>
</dict>
</plist>
