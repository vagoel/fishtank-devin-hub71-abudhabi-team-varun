# /etc/heatguard/heatguard.env for deploy/heatguard.service (systemd EnvironmentFile).
# Placeholders only. Keep the real file root:heatguard, mode 640.
# systemd syntax: KEY=VALUE per line, no "export", no inline comments.

# Integrations. Without a key the matching feature degrades gracefully:
# no OpenAI key = voice assistant offline; no Devin key = local incident analyser.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxx

# Server
PORT=8000
# Dashboard link included in WhatsApp escalations
HEATGUARD_PUBLIC_URL=http://192.168.1.10:8000
# Site pin (the wearable has no GPS; escalations use this + the worker's zone)
HEATGUARD_SITE_NAME=Camp gateway (example)
HEATGUARD_LAT=24.8962
HEATGUARD_LON=55.1602

# WhatsApp escalation: dryrun | twilio | meta | callmebot
WHATSAPP_PROVIDER=dryrun
WHATSAPP_TO=+9715XXXXXXXX,+9715YYYYYYYY

# twilio
#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# meta (WhatsApp Business Cloud API)
#META_WA_TOKEN=EAAxxxxxxxxxxxxxxxx
#META_WA_PHONE_ID=123456789012345
#META_WA_TEMPLATE=heatguard_incident
#META_WA_TEMPLATE_LANG=en
#META_WA_TEMPLATE_PARAMS=headline,worker,where,response,maps

# callmebot (single recipient: the first WHATSAPP_TO number)
#CALLMEBOT_APIKEY=1234567
